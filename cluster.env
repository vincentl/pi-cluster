# pi-cluster settings. Sourced by every script in head/. Edit before copying to the head node.

CLUSTER_USER=pi            # login user on every node; must match the user created in Imager
HEAD_NODE=pi-login         # head node hostname; must match the hostname given in Imager
NODE_PREFIX=pi-            # compute node N is ${NODE_PREFIX}NNN, for example pi-001

CLUSTER_NET=10.0.0.0/8     # the network on the switch side
HEAD_IP=10.0.0.1           # head node address on eth0
NODE_SUBNET=10.0.1         # compute node N gets ${NODE_SUBNET}.N, so N is 1..254

OS_IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64_latest   # compute node OS
